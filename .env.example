# ===========================================================================
# Next.js env: .env.local in development, Vercel project settings in prod.
# ===========================================================================

# Written by `npx convex dev` locally. In prod: from the Convex dashboard.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Public origin of this site, no trailing slash (http://localhost:3000 in dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile site key (public). Dev uses Cloudflare's always-pass
# test key 1x00000000000000000000AA; prod uses the key from your Turnstile widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Sentry (optional until set; monitoring is a no-op without them).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Only used by `npm run seed:admin` to create the single owner account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# ===========================================================================
# Convex deployment env: set with `npx convex env set NAME value`
# (add --prod for production). NEVER put these in Next.js env.
# ===========================================================================
#   BETTER_AUTH_SECRET          random 32+ bytes: `openssl rand -base64 32`
#   SITE_URL                    same value as NEXT_PUBLIC_SITE_URL
#   TURNSTILE_SECRET_KEY        Turnstile secret (dev: 1x0000000000000000000000000000000AA)
#   TURNSTILE_EXPECTED_HOSTNAME prod only: your domain, e.g. eriamamiya.com
#   RESEND_API_KEY              from resend.com (contact notifications)
#   RESEND_FROM                 e.g. "Eri's website <inbox@eriamamiya.com>" (verified domain)
#   RESEND_TEST_MODE            set to "false" in production
